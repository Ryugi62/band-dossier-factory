+class SlowGateway(FakeGateway):
+    """Like the network: a call yields before it is paid, so concurrent probes all reserve before any render."""
+
+    async def extract(self, meter, url, render=False):
+        await asyncio.sleep(0)
+        return await super().extract(meter, url, render)
+
+
+class LiveBudgetSplit(unittest.TestCase):
+    """Live web: plain probes (1 unit each) must not spend the units that rendering needs (3 each) — otherwise
+    every supporting page is probed, none rendered, and the dossier is all unknown (measured on runway.com and stripe.com)."""
+
+    def test_probes_leave_room_to_render_when_many_pages_match(self):
+        hits = {D: [SearchHit(f"https://acme.test/p{i}", "About Acme", "") for i in range(60)]}
+        pages = {f"https://acme.test/p{i}": "Kind: own\n\nAcme was founded in 2014." for i in range(60)}
+        gw = SlowGateway(hits, pages, claims=[], live=True)
+        fields, meter = build(gw)
+        self.assertGreaterEqual(len([c for c in gw.calls if c[0] == "render"]), 1)
+        self.assertEqual(fields["founded_year"]["value"], 2014)
+        self.assertLessEqual(meter.spent, 80)
